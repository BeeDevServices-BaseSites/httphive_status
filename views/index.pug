extends layout

block content
  h1 HTTPHive Status

  if error
    p.error= error

  p Last updated: #{lastUpdated.toLocaleString()}

  each group in groups
    section
      h2= group.label

      each serviceGroup in serviceGroups.filter(sg => sg.group === group.id && sg.is_active)
        .service-group
          h3= serviceGroup.label

          each monitor in monitors.filter(m => m.serviceGroup === serviceGroup.id && m.public)
            .monitor
              strong= monitor.displayName
              div.statusCard
                span.status(class=monitor.status.toLowerCase())= monitor.status
                if monitor.url
                  a(href=monitor.url target="_blank") Visit